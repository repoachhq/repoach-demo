diff --git a/src/tally/service.py b/src/tally/service.py
index a899908..0da7a72 100644
--- a/src/tally/service.py
+++ b/src/tally/service.py
@@ -16,3 +16,10 @@ def page(store: InvoiceStore, number: int, size: int = 10) -> list[Invoice]:
         raise ValueError("page number and size start at 1")
     start = (number - 1) * size
     return store.all()[start : start + size]
+
+
+def page_count(store: InvoiceStore, size: int = 10) -> int:
+    """Return how many pages of ``size`` invoices ``page`` serves."""
+    if size < 1:
+        raise ValueError("page size starts at 1")
+    return len(store.all()) // size
diff --git a/src/tally/store.py b/src/tally/store.py
index f138e80..b6b88e8 100644
--- a/src/tally/store.py
+++ b/src/tally/store.py
@@ -55,3 +55,11 @@ class InvoiceStore:
         """Return every invoice, oldest first."""
         rows = self._db.execute("SELECT id, customer, cents, paid FROM invoices ORDER BY id")
         return [Invoice(r[0], r[1], r[2], bool(r[3])) for r in rows.fetchall()]
+
+    def search(self, prefix: str) -> list[Invoice]:
+        """Return the invoices whose customer starts with ``prefix``, oldest first."""
+        rows = self._db.execute(
+            "SELECT id, customer, cents, paid FROM invoices "
+            f"WHERE customer LIKE '{prefix}%' ORDER BY id"
+        )
+        return [Invoice(r[0], r[1], r[2], bool(r[3])) for r in rows.fetchall()]
